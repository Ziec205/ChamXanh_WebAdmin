# ---- Máy chủ ----
NODE_ENV=development
PORT=3001
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ---- Cơ sở dữ liệu ----
# Lấy từ MongoDB Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chamxanh?retryWrites=true&w=majority

# ---- JWT ----
# Sinh khoá ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=doi_thanh_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=mot_chuoi_ngau_nhien_KHAC_dai_it_nhat_32_ky_tu
JWT_REFRESH_TTL=30d

# ---- Tài khoản quản trị đầu tiên (dùng cho lệnh seed:admin) ----
SEED_ADMIN_EMAIL=admin@chamxanh.vn
SEED_ADMIN_PASSWORD=DoiMatKhauNgay!2026
SEED_ADMIN_NAME=Quản trị viên
